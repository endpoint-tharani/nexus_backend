model Company {
  id                      String                    @id @default(uuid())
  name                    String
  email                   String?
  phone                   String?
  address                 String?
  website                 String?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  studentSelfRegistrationEnabled Boolean @default(false)
  rootUserId              String?
  branches                Branch[]
  rootUser                User?                     @relation("CompanyRootUser", fields: [rootUserId], references: [id])
  companyModules          CompanyModule[]
  subscriptions           CompanySubscription[]
  departments             Department[]
  userInvites            UserInvite[]
  users                   User[]                    @relation("CompanyUsers")
  studentProfiles         StudentProfile[]
  studentActivities       StudentActivity[]
  studentStaffAssignments StudentStaffAssignment[]
  studentAdmissionCodes   StudentAdmissionCode[]
  instructorProfiles      InstructorProfile[]
  instructorBranches      InstructorBranch[]
  instructorDepartments   InstructorDepartment[]

  @@index([name])
}
