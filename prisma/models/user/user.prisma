model User {
  id                          String               @id @default(uuid())
  name                        String
  email                       String               @unique
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt
  isEmailVerified             Boolean              @default(false)
  mustChangePassword          Boolean              @default(false)
  deletedAt                   DateTime?
  companyId                   String?
  userRole                    UserRole
  auditLogs                   AuditLog[]
  ownedCompanies              Company[]            @relation("CompanyRootUser")
  refreshTokens               RefreshToken[]
  company                     Company?             @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: Cascade)
  credential                  Credential?
  studentProfile              StudentProfile?
  instructorProfile           InstructorProfile?
  approvedInstructorProfiles  InstructorProfile[] @relation("InstructorApprover")
  createdInstructorBranches   InstructorBranch[] @relation("InstructorBranchCreator")
  createdInstructorDepartments InstructorDepartment[] @relation("InstructorDepartmentCreator")
  studentActivityActions       StudentActivity[]       @relation("StudentActivityActor")
  studentStaffAssignments      StudentStaffAssignment[] @relation("AssignedStaff")
  createdStudentAssignments    StudentStaffAssignment[] @relation("AssignmentCreator")
  otpChallenges                OtpChallenge[]

  @@unique([id, companyId])
}
